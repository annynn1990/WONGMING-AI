{
  "version": 2,
  "builds": [
    {"src":"api/tts.js","use":"@vercel/node"},
    {"src":"api/museum-grass.js","use":"@vercel/node"},
    {"src":"api/museum-banner.js","use":"@vercel/node"},
    {"src":"api/chat.js","use":"@vercel/node"},
    {"src":"*.html","use":"@vercel/static"},
    {"src":"npc300302/npc300302.skel","use":"@vercel/static"},
    {"src":"npc300302/npc300302.atlas","use":"@vercel/static"},
    {"src":"npc300302/npc300302.png","use":"@vercel/static"},
    {"src":"embed.js","use":"@vercel/static"},
    {"src":"knowledge.js","use":"@vercel/static"},
    {"src":"api/locale.js","use":"@vercel/node"},
    {"src":"api/translate.js","use":"@vercel/node"},
    {"src":"i18n.js","use":"@vercel/static"},
    {"src":"translation-page.js","use":"@vercel/static"}
  ],
  "routes": [
    {"src":"/api/tts","dest":"/api/tts.js"},
    {"src":"/api/museum-grass","dest":"/api/museum-grass.js"},
    {"src":"/api/museum-banner","dest":"/api/museum-banner.js"},
    {"src":"/api/locale","dest":"/api/locale.js"},
    {"src":"/api/translate","dest":"/api/translate.js"},
    {"src":"/museum/?","dest":"/museum.html"},
    {"src":"/","dest":"/index.html"},
    {"handle":"filesystem"}
  ]
}